{
  "functions": {
    "api/*.php": { "runtime": "vercel-php@0.7.3" },
    "*.php": { "runtime": "vercel-php@0.7.3" },
    "alat/*.php": { "runtime": "vercel-php@0.7.3" },
    "penyewa/*.php": { "runtime": "vercel-php@0.7.3" },
    "penyewaan/*.php": { "runtime": "vercel-php@0.7.3" }
  },
  "routes": [
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}